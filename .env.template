# Infrastructure
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REQUIRED for docker compose on bot-server (redis --requirepass).
# Containers on the compose network still use REDIS_HOST=redis; host tools use
# 127.0.0.1:6379. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Store only in the host env file (e.g. ~/.env.trading) — never commit the value.
REDIS_PASSWORD=
# Sliding TTL for kalman:{pair_id} Redis hashes (default 14d). Active pairs refresh on save.
# KALMAN_STATE_TTL_SECONDS=1209600
REDIS_APPENDONLY=yes

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=bot_admin
# REQUIRED — choose a strong non-default value. If changing this for an
# existing Postgres volume, rotate the bot_admin database password too.
POSTGRES_PASSWORD=
POSTGRES_DB=trading_bot
DB_PATH=data/trading_bot.db

# AI & Voice (Intelligence Hub)
OPENAI_API_KEY=your_openai_key
GEMINI_API_KEY=your_gemini_key

# Alpaca API
# The default URL is Alpaca paper trading.
ALPACA_API_KEY=your_alpaca_key
ALPACA_API_SECRET=your_alpaca_secret
ALPACA_BASE_URL=https://paper-api.alpaca.markets
BROKERAGE_PROVIDER=ALPACA
# Optional hard budget cap for Alpaca execution (0 = use broker cash/buying power)
ALPACA_BUDGET_USD=0
# Skip startup *block* when the broker holds positions outside the bot ledger.
# true: continue scanning (paper/dev with foreign Alpaca inventory); still logs + alerts
#       with a full reconciliation audit — never auto-flattens unmanaged overnight.
# false: required for live / unattended reconciliation (fail closed until import/close).
IGNORE_UNMANAGED_POSITIONS=true

# Market Data
POLYGON_API_KEY=your_polygon_key

# Telegram Notification (Human-in-the-Loop)
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id

# Risk Management
MAX_ALLOCATION_PERCENTAGE=15.0
DEFAULT_WIN_PROBABILITY=0.55
DEFAULT_WIN_LOSS_RATIO=1.0
MAX_FRICTION_PCT=0.015
FLAT_ORDER_FRICTION_USD=0.0
SHADOW_FILL_SLIPPAGE_BPS=5
CORP_ACTION_PRICE_JUMP_PCT=0.15
KELLY_LEDGER_MIN_TRADES=20
MICRO_TRADE_THRESHOLD_USD=5.0
MIN_TRADE_VALUE=1.0
FINANCIAL_KILL_SWITCH_PCT=0.02
TARGET_CASH_PER_LEG=0
RISK_DRAWDOWN_ZERO_PCT=0.15
RISK_SHARPE_FLOOR=0.5
RISK_MULTIPLIER_CAP_LOW_SHARPE=0.1
RISK_SLIPPAGE_NORMAL=0.001
RISK_SLIPPAGE_HIGH_VOL=0.0005
VOLATILITY_ENTROPY_THRESHOLD=0.8
VOLATILITY_FALLBACK_ENTROPY=0.5
MARKET_REGIME_FALLBACK_CONFIDENCE=0.5
MARKET_REGIME_BASE_CONFIDENCE=0.7
MARKET_REGIME_EMA_BULL_FACTOR=1.01
MARKET_REGIME_EMA_BEAR_FACTOR=0.99
MARKET_REGIME_VOLATILITY_HIGH=0.30
MARKET_REGIME_VOLATILITY_LOW=0.10
MARKET_REGIME_ENTROPY_SPIKE=0.85
ORCH_AGENT_CONFIDENCE_THRESHOLD=0.5
# Bull/bear theme agents: default heuristic stubs (labeled non-LLM). Keep ENABLED=false
# overnight so OpenAI/Gemini keys (if present) are not spent without an operator opt-in.
# Caps are process-local; exhausted budget falls back to the heuristic.
BULL_BEAR_LLM_ENABLED=false
BULL_BEAR_LLM_MAX_CALLS_PER_HOUR=4
BULL_BEAR_LLM_MAX_CALLS_PER_DAY=20
BULL_BEAR_LLM_MODEL_GEMINI=gemini-1.5-flash
BULL_BEAR_LLM_MODEL_OPENAI=gpt-4o-mini
ORCH_FUNDAMENTAL_DEFAULT_SCORE=50
ORCH_FUNDAMENTAL_VETO_SCORE=40
ORCH_FUNDAMENTAL_MAX_AGE_SECONDS=86400
SEC_WORKER_REFRESH_SECONDS=43200
SEC_WORKER_UNREACHABLE_THRESHOLD=3
SEC_WORKER_UNREACHABLE_BACKOFF_SECONDS=1800
ORCH_ACCURACY_LOW_THRESHOLD=0.4
ORCH_ACCURACY_HIGH_THRESHOLD=0.7
ORCH_ACCURACY_LOW_MULTIPLIER=0.7
ORCH_ACCURACY_HIGH_MULTIPLIER=1.1
GLOBAL_STRATEGY_ACCURACY_DEFAULT=0.5

# Whale watcher is legacy-dormant on the hot path. Keep ENABLED=false until a
# restored cache-backed evaluator is shipped with tests (GitHub #91). Flipping
# this flag alone does NOT activate veto/boost today — the stub ignores it.
WHALE_WATCHER_ENABLED=false
WHALE_WATCHER_ROLLING_WINDOW_SECONDS=1800
WHALE_WATCHER_CACHE_TTL_SECONDS=3600
WHALE_WATCHER_MAX_EVENTS_PER_SYMBOL=250
WHALE_WATCHER_MIN_VALUE_USD=5000000
WHALE_WATCHER_EXTREME_VALUE_USD=50000000
WHALE_WATCHER_VETO_SCORE=0.85
WHALE_WATCHER_VETO_MIN_EVENTS=2
WHALE_WATCHER_RISK_MULTIPLIER=0.85
WHALE_WATCHER_SUPPORT_MULTIPLIER=1.05

# News risk overlay (veto-only — NOT directional news trading). Default off.
# Missing feed/API → inactive no-veto (does not block the book).
# Enable RSS: NEWS_RISK_ENABLED=true + NEWS_RISK_PROVIDER=rss + NEWS_RISK_FEED_URLS=...
# Example feeds (Yahoo Finance RSS): https://finance.yahoo.com/rss/headline?s=KO,PEP
NEWS_RISK_ENABLED=false
NEWS_RISK_TTL_SECONDS=7200
NEWS_RISK_CACHE_SECONDS=300
NEWS_RISK_MAX_HEADLINES=50
NEWS_RISK_VETO_SCORE=0.75
NEWS_RISK_SHRINK_SCORE=0.55
NEWS_RISK_CONFIDENCE_MULTIPLIER=0.85
NEWS_RISK_PROVIDER=rss
NEWS_RISK_FEED_URLS=
NEWS_RISK_FEED_FILE=
NEWS_RISK_LLM_ENABLED=false

COINTEGRATION_MIN_OBSERVATIONS=20
COINTEGRATION_PVALUE_THRESHOLD=0.05
# Crypto ADF gate (looser than equity default 0.05). Missing from older templates
# broke CI patches that asserted settings.CRYPTO_COINTEGRATION_PVALUE_THRESHOLD.
CRYPTO_COINTEGRATION_PVALUE_THRESHOLD=0.10
PORTFOLIO_RISK_FREE_RATE=0.02
SGOV_SWEEP_TICKER=SGOV
MIN_SWEEP_THRESHOLD=10.0

# Book / crowding limits (paper-safe defaults)
MAX_ACTIVE_PAIRS=12
MAX_OPEN_PAIRS=8
MAX_PAIR_GROSS_NOTIONAL_USD=100.0
MAX_PORTFOLIO_GROSS_NOTIONAL_USD=800.0
BLOCK_SHARED_LEG_OPENS=true
MAX_SECTOR_EXPOSURE=0.30

# Pair discovery / scout frozen by default (curated US universe)
PAIR_DISCOVERY_ENABLED=false
PAIR_DISCOVERY_AUTO_PROMOTE=false
PAIR_DISCOVERY_MAX_TICKERS=12
PAIR_DISCOVERY_MAX_ABS_HEDGE=25.0
# Crypto pairs use a higher abs-hedge ceiling (price ratios are naturally large).
PAIR_DISCOVERY_MAX_ABS_HEDGE_CRYPTO=1000.0
PAIR_DISCOVERY_MIN_ABS_HEDGE=0.05
PAIR_DISCOVERY_MIN_CORRELATION=0.70
PAIR_DISCOVERY_MAX_PVALUE=0.05
PAIR_DENYLIST=BTC-USD_BCH-USD,BCH-USD_BTC-USD
SCOUT_INTERVAL_HOURS=12
SCOUT_INITIAL_DELAY_SECONDS=1200
ELITE_ROTATION_SORTINO_THRESHOLD=2.0

# Monitor / Signal thresholds
# Do NOT set MONITOR_ENTRY_ZSCORE below 1.0 (env or data/bot_settings.json) —
# runtime clamps to 1.0 and logs a warning. Prefer 2.0 for production paper.
MONITOR_ENTRY_ZSCORE=2.0
MONITOR_MIN_AI_CONFIDENCE=0.5
ORCHESTRATOR_TIMEOUT_SECONDS=60.0
# Align with Settings default (was 8.0 in older templates; yfinance/Alpaca need headroom).
MARKET_DATA_TIMEOUT_SECONDS=45.0
MARKET_DATA_BATCH_SIZE=30
MARKET_DATA_BATCH_CONCURRENCY=3
SPREAD_GUARD_MAX_PCT=0.003
TAKE_PROFIT_ZSCORE=0.5
# Exit when |z| is at/below this floor even if fees not cleared (mean reversion done).
# Missing TAKE_PROFIT_FORCE_EXIT_ZSCORE previously broke CI AttributeError patches.
TAKE_PROFIT_FORCE_EXIT_ZSCORE=0.25
STOP_LOSS_ZSCORE=3.5
# Scan loop pacing (Mini PC: keep pair/exit concurrency ≤2; interval 15–30s).
SCAN_INTERVAL_SECONDS=15
SCAN_PAIR_CONCURRENCY=2
SCAN_EXIT_CONCURRENCY=2
SCAN_COINT_RECHECK_CONCURRENCY=1

# LIVE_CAPITAL_DANGER: If true, bot refuses to boot if L2 entropy baselines are missing.
# Use with extreme caution.
LIVE_CAPITAL_DANGER=false

# Operational
# PAPER_TRADING=true  → local shadow fills (auto-approve, no broker orders).
# PAPER_TRADING=false + ALPACA_BASE_URL=https://paper-api.alpaca.markets
#   → broker Alpaca paper (real paper orders, auto-approve without Telegram).
# PAPER_TRADING=false + ALPACA_BASE_URL=https://api.alpaca.markets
#   → LIVE real money (Telegram/dashboard approval required; never auto-approve).
PAPER_TRADING=true
PAPER_TRADING_STARTING_CASH=10000
VITE_API_TIMEOUT_MS=15000
# Intentionally unused for real-money live: capital stays fail-closed without Telegram.
# Alpaca paper auto-approve uses settings.should_auto_approve_trades instead.
ALLOW_LIVE_APPROVAL_WITHOUT_TELEGRAM=false
ACCOUNT_CURRENCY=EUR
REGION=US
MARKET_TIMEZONE=America/New_York
LOG_LEVEL=INFO
# Decision Flight Recorder (spec 039): compact|verbose|off
DECISION_TRACE_LEVEL=compact
DECISION_TRACE_RING_SIZE=2000
DECISION_TRACE_INPUT_MAX_CHARS=500

# DEV_MODE: Enables 24/7 testing via Crypto pairs (BTC-USD, SOL-USD) as proxies.
# Bypasses NYSE/NASDAQ market hours.
# WARNING: DEV_MODE=true randomizes prices in DataService and bypasses NYSE hour checks.
# NEVER set true in production — it generates false signals and skips real risk guards.
DEV_MODE=false

SEC_USER_AGENT="Project-Arbitrage-Elite admin@example.com"

# DASHBOARD_TOKEN: Secure token for the Adaptive Intelligence Web UI.
# REQUIRED — leave blank; operators must choose a strong value (e.g. `openssl rand -hex 32`).
# Never check the real value into source control.
DASHBOARD_TOKEN=
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# Optional CORS regex. Leave blank to allow localhost, private LAN IPs, Tailscale IPs, and Raspberry Pi hostnames.
DASHBOARD_ALLOWED_ORIGIN_REGEX=

# Execution Engine (Feature 027 - gRPC)
EXECUTION_ENGINE_HOST=execution-engine
EXECUTION_ENGINE_PORT=50051
DRY_RUN=true
LATENCY_ALARM_THRESHOLD_MS=10.0

# Optional FastMCP tool server (src/mcp_server.py). Defaults: bind 127.0.0.1:8000.
# Docker compose sets MCP_HOST=0.0.0.0 + MCP_ALLOW_NON_LOOPBACK=true inside the
# container only; host publish stays 127.0.0.1:8000. Never republish :8000 publicly.
# MCP_TOOL_TOKEN=   # optional shared secret; when set, tools require auth_token=
# MCP_HOST=127.0.0.1
# MCP_PORT=8000
# MCP_ALLOW_NON_LOOPBACK=false

# Operation Hours (America/New_York default)
START_HOUR=9
START_MINUTE=30
END_HOUR=16
END_MINUTE=0

# Pair eligibility and cointegration gates
BLOCK_CROSS_CURRENCY_PAIRS=true
BLOCK_LSE_PAIRS_FOR_SHORT_HOLD=true
ALLOW_EU_CONTINENTAL_OVERLAP=false
PAIR_MAX_ROUND_TRIP_COST_PCT=0.0125
COINTEGRATION_ROLLING_ENABLED=true
COINTEGRATION_ROLLING_WINDOW=60
COINTEGRATION_ROLLING_STEP=5
COINTEGRATION_ROLLING_PASS_RATE=0.7
KALMAN_USE_Q_INFLATION=true
KALMAN_Q_SESSION_FACTOR=5.0
KALMAN_Q_SESSION_BARS=10
MONITOR_ENTRY_ZSCORE_COST_SCALING_ENABLED=false
MONITOR_ENTRY_ZSCORE_COST_BASELINE=0.0015
MONITOR_ENTRY_ZSCORE_COST_SCALING_CAP=3.0

# OpenTelemetry tracing (#118) — off by default; no export without endpoint.
# OTEL_ENABLED=false
# OTEL_SERVICE_NAME=alpha-arbitrage
# OTEL_EXPORTER_OTLP_ENDPOINT=   # e.g. http://localhost:4318 (OTLP/HTTP)
# OTEL_TRACES_SAMPLER_ARG=1.0

# Sentry errors (#119) — fail-closed when DSN empty; keep disabled in paper/dev.
# SENTRY_ENABLED=false
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=   # default: paper when PAPER_TRADING else live
# SENTRY_SAMPLE_RATE=1.0
# SENTRY_TRACES_SAMPLE_RATE=0.0   # leave 0; OTel owns traces
# SENTRY_RELEASE=                 # optional; falls back to IMAGE_TAG / GIT_COMMIT
# Frontend (Vite): VITE_SENTRY_DSN=  (empty = no browser SDK)

# Legacy/Fallback
DATABASE_URL=
